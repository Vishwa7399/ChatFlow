// This is your Prisma schema file

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"] 
}

datasource db {
  provider = "postgresql"
}

model Message {
  id             String       @id @default(uuid())
  text           String

  senderId       String
  // NEW: Added Cascade
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  conversationId String
  // NEW: Added Cascade
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique
  password       String   
  createdAt      DateTime @default(now())

  // NEW: The reverse connections
  messages       Message[]
  conversations  ConversationParticipant[]
}

// Define the two types of chats our app supports
enum ConversationType {
  PRIVATE
  GROUP
}

model Conversation {
  id            String                    @id @default(uuid())
  name          String?                   // Optional: Only used for Group chats
  type          ConversationType          @default(PRIVATE)
  createdAt     DateTime                  @default(now())
  
  // The connections:
  participants  ConversationParticipant[]
  messages      Message[]
}

// The Bridge (Junction Table) linking Users and Conversations
model ConversationParticipant {
  id             String       @id @default(uuid())
  
  userId         String
  // NEW: Added Cascade
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  conversationId String
  // NEW: Added Cascade
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  joinedAt       DateTime     @default(now())

  @@unique([userId, conversationId]) 
}