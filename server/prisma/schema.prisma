// This is your Prisma schema file

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"] 
}

datasource db {
  provider = "postgresql"
}

model Message {
  id          String   @id @default(uuid())
  author      String   
  roomId      String
  text        String 
  createdAt   DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique // Prevents duplicate registrations
  password  String   // Will safely store our bcrypt hashes
  createdAt DateTime @default(now())
}